# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.venv/
venv/

paper

# The repo's own scratch results/ dir (default output when RFM_RESULTS_DIR is unset)
results/**
!results/.gitkeep
!results/**/manifest.json
!results/**/*_manifest.json

# --- Result artifacts -------------------------------------------------------
# By default every result JSON is ignored ANYWHERE (so a download into e.g.
# notebooks/ can never leak into git), together with the heavy/internal ones.
e1_surface_*.json
e1_breaking_cells_*.json
e2_signatures_*.json
e3_causal_*.json
e4_families.json
e5_robustness_*.json
gate_eager_reference.json
*.pre_pairfix
*.npz

# EXCEPT the curated published snapshot in rfm_results/ (the paper's result JSONs)…
!rfm_results/**

# …minus its heavy or internal parts, which stay out even inside rfm_results/.
rfm_results/checkpoints/
rfm_results/**/*.pre_pairfix
rfm_results/**/*.npz

# OS
.DS_Store
Thumbs.db
