# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.venv/
venv/

# Results are large and machine-produced. Only manifests + breaking-cell lists
# and the small analysis JSONs are meant to be committed; everything else is
# regenerated. See §3 of the task spec ("results/ gitignored except manifests").
results/**
!results/.gitkeep
!results/**/manifest.json
!results/**/*_manifest.json

# Donor activation stores (large binary)
*.npz

# OS
.DS_Store
Thumbs.db
